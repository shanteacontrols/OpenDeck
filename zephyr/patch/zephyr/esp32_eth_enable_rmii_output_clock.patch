diff --git a/drivers/ethernet/eth_esp32.c b/drivers/ethernet/eth_esp32.c
index a4e5d7f14..e1a27961c 100644
--- a/drivers/ethernet/eth_esp32.c
+++ b/drivers/ethernet/eth_esp32.c
@@ -694,6 +694,8 @@ int eth_esp32_initialize(const struct device *dev)
 		}
 
 		emac_ll_clock_enable_rmii_output(dev_data->hal.ext_regs);
+		/* Set the PHY reference clock divider before waiting for MAC reset. */
+		(void)emac_hal_ref_clock_div(&dev_data->hal, 0);
 		esp_clk_tree_enable_src(SOC_MOD_CLK_APLL, true);
 		res = esp32_emac_config_apll_clock();
